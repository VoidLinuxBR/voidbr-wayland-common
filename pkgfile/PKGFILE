	voidbr-sddm-themes     # Temas do sddm VoidBR
	voidbr-iso-writer      # Gravar ISO em pendrive (GUI)
	xdg-desktop-portal     # Camada de comunicação apps/desktop
	xdg-desktop-portal-gtk # Implementação GTK do portal XDG
	xdg-user-dirs          # Gerenciamento de pastas do usuário
	xdg-user-dirs-gtk      # GTK+ tool xdg-user-dirs
	xdg-utils              # Integração com área de trabalho (scripts, X e Wayland)
	xfce4-terminal         # Terminal (GUI)
	xorg-server-xwayland   # Compatibilidade com apps X11 legados (infra Wayland)
