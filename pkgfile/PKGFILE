arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	chili-iso2usb          # Gravar ISO em pendrive (GUI)
	voidbr-webapps
	file-roller            # Gerenciador de compactados (GUI)
	firefox                # Navegador Firefox
	firefox-i18n-pt-BR     # Firefox em português (Brasil)
	gparted                # Editor de partições (GUI)
	kitty                  # Terminal (GUI)
	mate-calc              # Calculadora (GUI)
	mate-polkit            # Agente de autenticação (GUI)
	mesa-demos             # Ferramentas de teste Mesa (inclui apps com janela)
	mesa-dri               # Drivers gráficos DRI (biblioteca, X e Wayland)
	mesa-vaapi             # Aceleração de vídeo VA-API (biblioteca, X e Wayland)
	mpv                    # Player de vídeo (GUI)
	network-manager-applet # Ícone de bandeja de rede (GUI)
	octoxbps               # Gerenciador de pacotes (GUI)
	pasystray              # Ícone de áudio (GUI)
	pavucontrol            # Controlador de volume (GUI)
	qt5-wayland            # QT5 - Wayland component
